# Imagen del servidor MCP local (stdio). Usada por clientes MCP en contenedor y
# por los checks automáticos de catálogos (Glama).
#
#   docker build -f Dockerfile.mcp -t latam-synth-mcp .
#   docker run -i --rm latam-synth-mcp
#
# El contenedor habla MCP por stdin/stdout: se ejecuta con -i (interactivo) y sin
# TTY. No expone puertos ni escribe en disco.
FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src/ ./src/

RUN pip install --no-cache-dir ".[mcp]"

# Sin buffering: stdio es el transporte, no puede quedarse a medias.
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["latam-synth-mcp"]
