      "template": "{{storages.datasets.default.apiUrl}}/items?view=transactions"
    },
    "run_summary": {
      "type": "string",
      "title": "Run summary (parameters, row counts, file list)",
      "template": "{{links.apiDefaultKeyValueStoreUrl}}/records/OUTPUT"
