# Imagen base oficial de Apify para Python
FROM apify/actor-python:3.11

WORKDIR /usr/src/app

# Copiar e instalar el paquete
COPY pyproject.toml ./
COPY src/ ./src/

RUN pip install --no-cache-dir -e ".[apify]" \
    && pip install --no-cache-dir apify

# Punto de entrada
CMD ["python", "-m", "latam_synth.actor"]
